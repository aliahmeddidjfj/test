{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "nixpacks": {
    "aptPkgs": ["ffmpeg", "python3", "python3-pip"],
    "phases": {
      "install": {
        "cmds": ["pip3 install yt-dlp"]
      }
    }
  }
}
